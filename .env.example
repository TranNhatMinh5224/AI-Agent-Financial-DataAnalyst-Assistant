# ================================================================================
# MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Copy file này thành .env và điền các API Key của bạn
# ================================================================================

# 1. Main LLM API (OpenRouter, SiliconFlow, OpenAI, v.v.)
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_PLANNER=qwen/qwen3-14b
LLM_MODEL_PROGRAMMER=qwen/qwen3-14b
LLM_MODEL_RETRIEVER=qwen/qwen-2.5-7b-instruct
LLM_MODEL_CRITIC=qwen/qwen-2.5-7b-instruct

# 2. Embedding & Reranker
EMBEDDING_MODEL=baai/bge-m3
RERANKER_MODEL=rrf
RERANKER_BASE_URL=
RERANKER_API_KEY=
EMBEDDING_BATCH_SIZE=32

# 3. Local Ollama Server
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL_DEFAULT=qwen2.5-coder:14b
OLLAMA_MODEL_SMALL=qwen2.5-coder:3b

# 4. SiliconFlow API (Optional)
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
